<!-- Project-specific OWASP dependency-check suppressions.
     Kept separate from dps-gradle-spring-boot-suppressions.xml, which is regenerated by the
     hmpps-gradle-spring-boot plugin on every build. Wired via dependencyCheck.suppressionFiles. -->

<suppressions
        xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <suppress>
        <notes><![CDATA[
    azure-identity 1.18.7 is outside the affected version ranges for
    CVE-2023-36415 and CVE-2024-35255.

    CVE-2026-33117 affects Azure Key Vault Keys local cryptographic verification.
    This application does not include azure-security-keyvault-keys or use the
    affected functionality.
    ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-identity@1\.18\.7$</packageUrl>
        <cve>CVE-2023-36415</cve>
        <cve>CVE-2024-35255</cve>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
    CVE-2026-33117 affects Azure Key Vault Keys local cryptographic verification.
    azure-core-http-netty is being matched as an Azure SDK dependency but does
    not contain the affected Key Vault Keys functionality.
    ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-core-http-netty@1\.16\.8$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
    CVE-2026-33117 affects Azure Key Vault Keys local cryptographic verification.
    azure-core is being matched as an Azure SDK dependency but does not contain
    the affected Key Vault Keys functionality.
    ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-core@1\.60\.0$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
    CVE-2026-33117 affects Azure Key Vault Keys local cryptographic verification.
    azure-json is being matched as an Azure SDK dependency but does not contain
    the affected Key Vault Keys functionality.
    ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.azure/azure-json@1\.5\.1$</packageUrl>
        <cve>CVE-2026-33117</cve>
    </suppress>

    <suppress>
        <notes><![CDATA[
            CVE-2024-35255 affects msal4j versions before 1.15.1.
            This project resolves msal4j 1.26.0 and is therefore not affected.]]>
        </notes>
        <packageUrl regex="true">^pkg:maven/com\.microsoft\.azure/msal4j@1\.26\.0$</packageUrl>
        <cve>CVE-2024-35255</cve>
    </suppress>

